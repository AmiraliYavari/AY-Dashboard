{
  "name": "ay-dashboard-backend",
  "version": "1.0.0",
  "description": "AY-Dashboard - Sales & Finance admin dashboard API (TypeScript)",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
